---
import Layout from '../layouts/Layout.astro';
import { CATEGORIES } from '../content.config';

const sectionList = Object.values(CATEGORIES);
---

<Layout
  title="Search"
  description="Search LacqueredMag — the editorial archive of essays on skin, makeup, fragrance, hair, and the lacquered life."
>
  <div class="search-page">
    <header class="search-page__header">
      <p class="search-page__rule">The archive</p>
      <h1 class="search-page__title">Search the magazine</h1>
      <p class="search-page__intro">Sixty essays, dispatched since October 2026. Type a word, a material, a year — the lacquer takes a moment to dry.</p>
    </header>

    <div id="search">
      <input
        type="search"
        id="search-input"
        class="search-page__input"
        placeholder="What are you looking for?"
        autocomplete="off"
        aria-label="Search articles"
      />
      <div id="search-status" class="search-page__status" aria-live="polite"></div>
      <ol id="search-results" class="search-page__results"></ol>
    </div>

    <nav class="search-page__sections" aria-label="Browse by section">
      <p class="search-page__sections-label">Or browse by section</p>
      <ul>
        {sectionList.map(c => <li><a href={`/category/${c.slug}/`}>{c.label}</a></li>)}
        <li><a href="/category/dispatches/">Dispatches</a></li>
      </ul>
    </nav>
  </div>

  <script is:inline>
    (async () => {
      try {
        // @ts-ignore
        await import('/pagefind/pagefind.js');
        // @ts-ignore
        const pf = window.pagefind;
        if (!pf) throw new Error('Pagefind not loaded');

        const input = document.getElementById('search-input');
        const status = document.getElementById('search-status');
        const results = document.getElementById('search-results');

        const escapeHTML = (s) => s.replace(/[&<>"']/g, c => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[c]));

        let debounce;
        input.addEventListener('input', () => {
          clearTimeout(debounce);
          debounce = setTimeout(async () => {
            const q = input.value.trim();
            if (q.length < 2) {
              results.innerHTML = '';
              status.textContent = '';
              return;
            }
            const search = await pf.search(q);
            status.textContent = `${search.results.length} ${search.results.length === 1 ? 'result' : 'results'}`;
            results.innerHTML = '';
            const top = search.results.slice(0, 20);
            for (const r of top) {
              const data = await r.data();
              const li = document.createElement('li');
              li.className = 'search-result';
              const kicker = data.meta?.kicker ? `<span class="search-result__kicker">${escapeHTML(data.meta.kicker)}</span>` : '';
              const img = data.meta?.image ? `<img class="search-result__image" src="${escapeHTML(data.meta.image)}" alt="" loading="lazy" />` : '';
              li.innerHTML = `
                <a href="${data.url}" class="search-result__link">
                  ${img}
                  <div class="search-result__body">
                    ${kicker}
                    <h3 class="search-result__title">${escapeHTML(data.meta?.title || data.url)}</h3>
                    <p class="search-result__excerpt">${escapeHTML(data.excerpt || '')}</p>
                  </div>
                </a>
              `;
              results.appendChild(li);
            }
          }, 180);
        });
        input.focus();
      } catch (err) {
        document.getElementById('search-status').textContent = 'Search index not built. Run `npm run build` to generate.';
      }
    })();
  </script>
</Layout>

<style>
  .search-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }
  .search-page__header {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 2.5rem 0 3rem;
    margin-bottom: 3rem;
  }
  .search-page__rule {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
    font-weight: 500;
  }
  .search-page__title {
    font-family: 'Fraunces', serif;
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
  }
  .search-page__intro {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.5;
    margin: 0;
    max-width: 56ch;
  }
  .search-page__input {
    width: 100%;
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    border: none;
    border-bottom: 1px solid var(--rule);
    padding: 1rem 0;
    background: transparent;
    color: var(--ink);
    outline: none;
  }
  .search-page__input:focus {
    border-bottom-color: var(--accent);
  }
  .search-page__status {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.55;
    margin: 1.5rem 0 0;
  }
  .search-page__results {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .search-result {
    border-top: 1px solid var(--rule);
    padding: 1.5rem 0;
  }
  .search-result__link {
    display: flex;
    gap: 1.5rem;
    text-decoration: none;
    color: var(--ink);
  }
  .search-result__image {
    width: 120px;
    height: 90px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .search-result__body {
    flex: 1;
  }
  .search-result__kicker {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .search-result__title {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }
  .search-result__excerpt {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.4;
    margin: 0;
    opacity: 0.75;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-page__sections {
    border-top: 1px solid var(--rule);
    margin-top: 4rem;
    padding-top: 2rem;
  }
  .search-page__sections-label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.55;
    margin: 0 0 1rem;
  }
  .search-page__sections ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .search-page__sections li a {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .search-page__sections li a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
