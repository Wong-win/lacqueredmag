---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Reach LacqueredMag's editorial desk."
>
  <article style="max-width: 720px; margin: 80px auto; padding: 0 24px;">
    <span class="eyebrow kicker--accent">Contact</span>
    <h1 style="margin-top: 16px; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1;">The editorial desk</h1>

    <div style="font-family: var(--font-body); font-size: 17px; line-height: 1.75; margin-top: 32px;">
      <p style="margin: 0 0 1.5em;">
        Pitches, corrections, subscriber questions, and press enquiries all live at the same address — read once a day, replied to within five business days.
      </p>

      <h2 style="font-family: var(--font-display); font-weight: 600; font-style: italic; font-size: 22px; margin: 2em 0 0.5em;">Editors</h2>
      <p style="margin: 0 0 1em;">
        <a href="mailto:editors@lacqueredmag.com" style="color: var(--accent);">editors@lacqueredmag.com</a>
      </p>

      <h2 style="font-family: var(--font-display); font-weight: 600; font-style: italic; font-size: 22px; margin: 2em 0 0.5em;">Submissions</h2>
      <p style="margin: 0 0 1em;">
        <a href="mailto:editors@lacqueredmag.com?subject=Submission" style="color: var(--accent);">editors@lacqueredmag.com</a>
      </p>

      <h2 style="font-family: var(--font-display); font-weight: 600; font-style: italic; font-size: 22px; margin: 2em 0 0.5em;">Press &amp; partnerships</h2>
      <p style="margin: 0 0 1em;">
        <a href="mailto:press@lacqueredmag.com" style="color: var(--accent);">press@lacqueredmag.com</a>
      </p>

      <h2 style="font-family: var(--font-display); font-weight: 600; font-style: italic; font-size: 22px; margin: 2em 0 0.5em;">Corrections</h2>
      <p style="margin: 0 0 1em;">
        We correct substantive errors in line. If you've spotted one, write to <a href="mailto:corrections@lacqueredmag.com" style="color: var(--accent);">corrections@lacqueredmag.com</a> with the URL and the paragraph in question.
      </p>
    </div>
  </article>
</Layout>
