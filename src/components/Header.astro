---
import { CATEGORIES } from '../content.config';

const categoryList = Object.values(CATEGORIES);
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label="LacqueredMag home">
      Lacquered<strong>Mag</strong>
    </a>
    <nav class="site-header__nav" aria-label="Sections">
      {categoryList.map((cat, i) => (
        <>
          {i > 0 && <span aria-hidden="true" style="color:var(--accent)">·</span>}
          <a href={`/category/${cat.slug}/`}>{cat.label}</a>
        </>
      ))}
    </nav>
    <a href="/search/" class="site-header__contact" aria-label="Search">Search</a>
    <a href="/contact/" class="site-header__contact">Contact</a>
  </div>
</header>
