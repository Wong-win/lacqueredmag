---
---
<section class="newsletter" aria-labelledby="newsletter-title">
  <h3 id="newsletter-title" class="newsletter__title">The Dispatches</h3>
  <p class="newsletter__pitch">A weekly note from the counter. No spam, ever.</p>
  <form class="newsletter__form" method="POST" action="#" aria-label="Subscribe to the dispatches">
    <label class="sr-only" for="newsletter-email">Email address</label>
    <input
      id="newsletter-email"
      class="newsletter__input"
      type="email"
      name="email"
      placeholder="you@email.com"
      required
      aria-required="true"
    />
    <button class="newsletter__button" type="submit">Subscribe</button>
  </form>
  <p class="newsletter__status" role="status" aria-live="polite">
    v1 stub — ESP wiring arrives in v2. We'll never share your address.
  </p>
</section>
